{
  "name": "alpaca-agent-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 execute alpaca-agent --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute alpaca-agent --remote --file=./schema.sql"
  },
  "dependencies": { "hono": "^4.6.14" },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.125.0"
  }
}
