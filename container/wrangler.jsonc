{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpaca-agent-runner",
  "account_id": "522e035ab8637119c0bf60363e5704ca",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The committee's runtime. amd64 — Cloudflare Containers do not run arm64.
  "containers": [
    {
      "class_name": "Committee",
      "image": "../agent/Dockerfile",
      "image_build_context": "../agent",
      "instance_type": "standard",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COMMITTEE", "class_name": "Committee" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Committee"] }],

  // Schedule lives here, not in a cron inside the image: visible in config and changeable
  // without a rebuild. Cron is UTC. US equities trade 13:30–20:00 UTC (09:30–16:00 ET) while
  // the US is on daylight time, which covers the whole competition window.
  //
  // Every 30 minutes from 13:30 to 19:30 UTC, weekdays. The 20:00 slot is deliberately
  // omitted — the NEAR_CLOSE gate blocks new positions inside the last 15 minutes anyway,
  // so a sitting then could only ever refuse.
  "triggers": {
    "crons": ["0,30 14-19 * * 1-5", "30 13 * * 1-5"]
  },

  "vars": {
    "API_ORIGIN": "https://alpaca-agent-api.domfly.workers.dev",
    // ⚠️ NARROWED FROM "QQQ,SPY,IWM" ON MEASURED EVIDENCE (2024-01 -> 2026-08, friction
    // crossed on all four legs both ways). QQQ was NEGATIVE EVEN BEFORE COSTS and IWM's
    // +$20 gross edge is exceeded by its own friction:
    //     SPY  gross  -$7.97   net -$15.97   |  at 45 DTE: +$21.50/condor
    //     QQQ  gross -$20.42   net -$52.42   <- no edge at any tenor
    //     IWM  gross +$20.01   net -$11.99   (9.4% spread eats it)
    // SPY also quotes far the tightest: 0.99% of mid vs SPX 2.37% and XSP 26.65%.
    "UNIVERSE": "SPY",
    // LIVE on the DEV paper account PA35CQR61R2Q (simulated funds, paper-api endpoint).
    // Flipped 2026-08-25 to exercise the two paths that had never run: the Executor placing
    // an order, and the exit rules seeing a real position with real spreads and overnight
    // marks. Neither is reproducible in a backtest.
    // ⚠️ On launch day this stays "false" but the KEYS change to the brand-new dedicated
    // submission account. The flag is not the thing to check then — the account number is.
    "DRY_RUN": "false",
    "MAX_TRADES": "2",
    "KILL_SWITCH": "false",
    // Soft spend caps enforced by our own code. Observed usage is ~$25/day; the structural
    // worst case is ~$140. The only HARD stop is a spend limit on the key in the Anthropic
    // Console — set that too.
    "DAILY_USD_CAP": "40",
    "MAX_CYCLE_USD": "6"
  }
}
